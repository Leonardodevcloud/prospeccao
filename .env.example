# Copie para .env na raiz do repositório (desenvolvimento local).
# Em produção, cada serviço do Railway recebe só as variáveis da sua seção.

# ---------- Todos os serviços ----------
DATABASE_URL=postgres://postgres@localhost:5432/prospeccao
LOG_LEVEL=info

# ---------- api ----------
PORT=3000
# Origem do web (sem barra no fim). Em produção: https://seu-projeto.vercel.app
APP_ORIGENS=http://localhost:5173
# 32+ caracteres aleatórios: openssl rand -base64 48
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
ADMIN_EMAIL=voce@exemplo.com
# Gere com: pnpm --filter @prospeccao/api hash-senha
ADMIN_SENHA_HASH=
SESSAO_HORAS=12
# Opcional: localizar bases pelo endereço (bases só importam em campanhas com raio)
ORS_API_KEY=

# ---------- worker-descoberta ----------
# Buscas no Maps pelo Google Places API (New) · Text Search. Ative a "Places API (New)" no
# Google Cloud. Franquia: 1.000 buscas grátis/mês, depois US$ 35 por mil (preços e tetos
# ficam na tela Campanhas › Google Places › Preços e teto). Mesma chave do enriquecimento.
# GOOGLE_PLACES_KEY=   (definida mais abaixo)
# MAPS_PROVEDOR=places   ("apify" força o Apify)
# Apify (legado, opcional): só sem GOOGLE_PLACES_KEY ou com MAPS_PROVEDOR=apify.
APIFY_TOKEN=
APIFY_MAPS_ATOR=compass~crawler-google-places
# Opções extras do ator, em JSON. Ex.: {"scrapePlaceDetailPage":true} para trazer "opções de serviço" (entrega)
APIFY_MAPS_INPUT_EXTRA={}
# ORS_API_KEY (acima) é opcional aqui também: só campanhas com raio usam, para localizar
# empresas que vieram só da Receita. Campanhas nacionais (o padrão) não precisam.
ORS_INTERVALO_MS=700
MAPS_REBUSCA_DIAS=30
MAPS_ESPERA_SEGUNDOS=60
MAPS_MAX_VERIFICACOES=90
GEO_CONFIANCA_MINIMA=0.6

# ---------- worker-cnpj ----------
# Compartilhamento oficial (Nextcloud/WebDAV). Também aceita um espelho com listagem HTML.
RECEITA_CNPJ_URL=https://arquivos.receitafederal.gov.br/public.php/dav/files/YggdBLfdninEJX9
# UFs importadas além das que as campanhas já usam (ex.: praças em estudo)
CNPJ_UFS_EXTRAS=
# Importação automática (fuso de São Paulo): dia 20, às 3h
CNPJ_AGENDA=0 3 20 * *
# Alternativa ao download: pasta com os zips já baixados (+ o mês deles)
CNPJ_PASTA_LOCAL=
CNPJ_MES_LOCAL=

# ---------- worker-enriquecimento ----------
# Todas opcionais: sem a chave, a fonte é pulada (e a trilha da ficha diz por quê).
# Serper (serper.dev, 2.500 grátis, depois centavos por mil): busca no Google do LinkedIn/Instagram,
# busca da razão social (diretórios + leitura pela IA) e, quando a cota grátis do Places acaba,
# acha a empresa no Maps pelo nome e endereço. Sem ela, usa o Apify e o Places.
SERPER_API_KEY=
# APIFY_TOKEN (acima) lê os perfis do Instagram e, sem SERPER_API_KEY, também faz a busca no Google.
APIFY_ATOR_GOOGLE=apify~google-search-scraper
APIFY_ATOR_INSTAGRAM=apify~instagram-profile-scraper
# Nota de ICP e leitura do site (aistudio.google.com). Sem ela, nota por regras.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Validação de WhatsApp pelo chip (só consulta; não envia mensagem). As três juntas.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
EVOLUTION_INTERVALO_MS=3000
# Google Places: acha pelo nome e endereço quem não apareceu no Maps (só na cota grátis, se houver
# SERPER_API_KEY; a cota é dividida com as campanhas) e confere os leads A e B.
GOOGLE_PLACES_KEY=
ENRIQ_ACHAR_NO_GOOGLE=true
ENRIQ_FAIXAS_LINKEDIN=A,B
ENRIQ_FAIXAS_PLACES=A,B
ENRIQ_BUSCAR_INSTAGRAM=true
ENRIQ_REFAZER_DIAS=30
ENRIQ_CONCORRENCIA=2
# Interruptor de emergência: true = o worker sobe mas não enriquece nada (a fila espera).
ENRIQ_PAUSADO=false

# ---------- web (desenvolvimento) ----------
# Para onde o Vite repassa /api
API_URL=http://localhost:3000

# ---------- testes de integração ----------
# Banco descartável: cada pacote cria o seu (<nome>_api, <nome>_cnpj, ...)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/prospeccao_teste
