# Copie para .env e preencha (veja o LEIAME.md).

# Z-API › instância › Chamadas (SIP): o ID da instância e a senha SIP gerada no painel.
ZAPI_INSTANCIA=3C67AB641C8AA0412F6A2242B4E23AC7
ZAPI_SIP_TOKEN=cole-aqui-a-senha-sip

# O número do WhatsApp dessa instância, com DDD (o mesmo cadastrado no CRM como "WhatsApp").
NUMERO_WHATSAPP=71991002000

# LiveKit Cloud › Telephony: o "SIP URI" do projeto, sem o "sip:" (ex.: abc123.sip.livekit.cloud).
LIVEKIT_SIP_HOST=abc123.sip.livekit.cloud

# IP público desta máquina (o LiveKit e a Z-API mandam o áudio para ele).
IP_PUBLICO=203.0.113.10

# Usuário e senha que você inventa para o tronco de saída do LiveKit entrar aqui.
SAIDA_USUARIO=prospectteam
SAIDA_SENHA=troque-por-uma-senha-longa

# Portas do áudio (abra no firewall, UDP).
RTP_INICIO=10000
RTP_FIM=10200
