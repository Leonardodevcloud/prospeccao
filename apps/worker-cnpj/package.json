    "@prospeccao/shared": "workspace:*",
    "csv-parse": "7.0.3",
    "iconv-lite": "0.7.3",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "pino": "10.4.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/yazl": "3.3.0",
    "yazl": "3.3.1"
  },
  "files": [
    "dist"
  ]
